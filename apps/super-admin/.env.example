DATABASE_URL="postgresql://roomlink@localhost:5432/rmdb?schema=public"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"

# Base URL of apps/hotel-admin (a separate app/deployment) — linked from
# Hotel Admin invite/reset emails sent by this app. Must be a real, reachable
# https URL in production.
HOTEL_ADMIN_APP_URL="http://localhost:3001"

# Optional — without these, invite/reset emails just log to the server console.
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

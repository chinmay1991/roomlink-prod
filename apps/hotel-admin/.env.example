# Same database as apps/super-admin — one architecture, one schema (packages/db),
# shared by both portals per the RoomLink dev rules.
DATABASE_URL="postgresql://roomlink@localhost:5432/rmdb?schema=public"

NEXTAUTH_URL="http://localhost:3001"
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"

# The GUEST app's public base URL (not this app's own URL) — every room QR
# code is generated as "${NEXT_PUBLIC_APP_URL}/r/<code>". Must be a real,
# reachable https URL in production; QR generation fails with a clear
# config error if this is unset.
NEXT_PUBLIC_APP_URL="http://localhost:3002"

# Local-only escape hatch to preview the native-app mobile chrome (MobileShell
# + MobileBottomNav) in a regular browser, before the Capacitor shell exists
# to send the real native User-Agent marker (see src/server/is-native-client.ts).
# Ignored outside development — never set this in production.
# FORCE_NATIVE_SHELL="1"

# ZegoCloud project credentials for guest-to-reception voice calling
# (src/server/zego-token.ts). App ID is safe to expose to the client (the
# call-invitation UIKit needs it in the browser); the server secret must
# never be. Voice-call token routes throw a clear config error if either is
# missing.
NEXT_PUBLIC_ZEGOCLOUD_APP_ID="replace-with-your-zego-app-id"
ZEGOCLOUD_SERVER_SECRET="replace-with-your-32-byte-zego-server-secret"

# Do NOT set this until the Capacitor mobile shell (apps/hotel-admin-mobile)
# has a real Firebase project (google-services.json in android/app/) and an
# Apple Developer Program APNs key configured. Until then, leaving this unset
# is what stops PushRegistration (src/components/layout/push-registration.tsx)
# from calling PushNotifications.register() — on Android specifically, that
# call crashes the whole native app if no Firebase project exists (confirmed:
# it throws on a background thread inside the plugin, not a rejectable
# promise). Registration/targeting/the escalation trigger all work today
# regardless of this flag; only actual device registration is gated on it.
# NEXT_PUBLIC_PUSH_ENABLED="1"
